# Application Settings
PROJECT_NAME="Clario API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="change_this_to_a_super_secret_key_in_production_32_bytes_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For SQLite (default development):
DATABASE_URL="sqlite:///./clario.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/clario_db"

# CORS Origins (JSON array of strings)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8081", "http://localhost:19006", "http://localhost:8082", "*"]'
