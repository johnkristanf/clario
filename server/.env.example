# Application Settings
PROJECT_NAME="Clario API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="change_this_to_a_super_secret_key_in_production_32_bytes_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL="postgresql+psycopg://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Storage & Supabase
UPLOAD_DIR="uploads"
SUPABASE_URL="https://your-project.supabase.co"
# Supabase API Keys (Secret Key for backend server, Publishable Key for client)
SUPABASE_SECRET_KEY="sbs_your_secret_key"
SUPABASE_PUBLISHABLE_KEY="sbp_your_publishable_key"
# JWT Secret for fast local token verification (Dashboard → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_STORAGE_BUCKET="recordings"

# External AI APIs
DEEPGRAM_API_KEY="your-deepgram-api-key"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-6-luna"

# CORS Origins (JSON array of strings)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8081", "http://localhost:19006", "http://localhost:8082", "*"]'
