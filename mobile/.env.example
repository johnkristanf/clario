# Clario Mobile App Environment Variables

# Supabase Configuration
# Latest Supabase Architecture: Use EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sbp_...)
# WARNING: NEVER expose Secret Keys (sbs_... / service_role) in this mobile client!
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sbp_your_publishable_key"

# Clario Backend API URL
# Default local dev:
# iOS Simulator: http://localhost:8000/api/v1
# Android Emulator: http://10.0.2.2:8000/api/v1
# Physical Device: http://<YOUR_LAN_IP>:8000/api/v1
EXPO_PUBLIC_API_URL="http://localhost:8000/api/v1"
